{
  "name": "tcg-platform",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/run-turbo.mjs dev --filter=@tcg/api --filter=@tcg/web",
    "dev:admin": "node scripts/run-turbo.mjs dev --filter=@tcg/admin",
    "dev:mobile": "node scripts/pnpm.mjs --filter @tcg/mobile start",
    "build": "node scripts/run-turbo.mjs build",
    "lint": "node scripts/run-turbo.mjs lint",
    "typecheck": "node scripts/run-turbo.mjs typecheck",
    "test": "node scripts/run-turbo.mjs test",
    "test:integration": "node scripts/pnpm.mjs --filter @tcg/api test:integration",
    "test:e2e": "node scripts/pnpm.mjs --filter @tcg/api beta:seed && playwright test",
    "test:maestro": "maestro test apps/mobile/.maestro/",
    "eas:android:preview": "node scripts/pnpm.mjs --filter @tcg/mobile eas:android:preview",
    "eas:ios:preview": "node scripts/pnpm.mjs --filter @tcg/mobile eas:ios:preview",
    "eas:ios:testflight": "node scripts/pnpm.mjs --filter @tcg/mobile eas:ios:testflight",
    "test:load": "node scripts/load-test.mjs",
    "db:explain": "node scripts/explain-hot-paths.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "beta:seed": "node scripts/pnpm.mjs --filter @tcg/api beta:seed",
    "staging:preflight": "node scripts/pnpm.mjs --filter @tcg/api exec tsx src/ops/staging-preflight.cli.ts",
    "db:up": "docker compose -f docker/compose.yml up -d",
    "db:down": "docker compose -f docker/compose.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:backup": "bash scripts/backup-postgres.sh",
    "catalog:seed": "node scripts/pnpm.mjs --filter @tcg/api catalog:seed",
    "catalog:seed-reference": "node scripts/pnpm.mjs --filter @tcg/api catalog:seed-reference",
    "catalog:import-myl": "node scripts/pnpm.mjs --filter @tcg/api catalog:import-myl",
    "catalog:import-myl-tor": "node scripts/pnpm.mjs --filter @tcg/api catalog:import-myl-tor",
    "catalog:enrich-myl": "node scripts/pnpm.mjs --filter @tcg/api catalog:enrich-myl",
    "catalog:seed-myl-demo": "node scripts/pnpm.mjs --filter @tcg/api catalog:seed-myl-demo",
    "catalog:import-scryfall": "node scripts/pnpm.mjs --filter @tcg/api run catalog:import-scryfall --",
    "catalog:import-pokemon": "node scripts/pnpm.mjs --filter @tcg/api run catalog:import-pokemon --",
    "catalog:reference:refresh": "node scripts/pnpm.mjs --filter @tcg/api run catalog:reference:refresh --",
    "catalog:attributes:audit": "node scripts/pnpm.mjs --filter @tcg/api catalog:attributes:audit",
    "catalog:attributes:backfill": "node scripts/pnpm.mjs --filter @tcg/api catalog:attributes:backfill",
    "ledger:backfill": "node scripts/pnpm.mjs --filter @tcg/api ledger:backfill",
    "recon:day": "node scripts/pnpm.mjs --filter @tcg/api recon:day",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prisma": "^6.15.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "postcss": "8.5.26",
      "next": "15.5.24",
      "eslint-config-next": "15.5.24",
      "multer": "2.3.0",
      "sharp": "0.35.4",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "@xmldom/xmldom@0.8": "0.8.15",
      "@xmldom/xmldom@0.9": "0.9.12",
      "fast-uri": "3.1.6",
      "nodemailer": "9.1.1",
      "deepmerge-ts": "8.0.2"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
