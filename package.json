{
  "name": "tcg-platform",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev --filter=@tcg/api --filter=@tcg/web",
    "dev:admin": "turbo dev --filter=@tcg/admin",
    "dev:mobile": "pnpm --filter @tcg/mobile start",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "pnpm --filter @tcg/api test:integration",
    "test:e2e": "pnpm --filter @tcg/api beta:seed && playwright test",
    "test:maestro": "maestro test apps/mobile/.maestro/",
    "eas:android:preview": "pnpm --filter @tcg/mobile eas:android:preview",
    "eas:ios:preview": "pnpm --filter @tcg/mobile eas:ios:preview",
    "eas:ios:testflight": "pnpm --filter @tcg/mobile eas:ios:testflight",
    "test:load": "node scripts/load-test.mjs",
    "db:explain": "node scripts/explain-hot-paths.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "beta:seed": "pnpm --filter @tcg/api beta:seed",
    "staging:preflight": "pnpm --filter @tcg/api exec tsx src/ops/staging-preflight.cli.ts",
    "db:up": "docker compose -f docker/compose.yml up -d",
    "db:down": "docker compose -f docker/compose.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:backup": "bash scripts/backup-postgres.sh",
    "catalog:seed": "pnpm --filter @tcg/api catalog:seed",
    "catalog:import-scryfall": "pnpm --filter @tcg/api run catalog:import-scryfall --",
    "catalog:attributes:audit": "pnpm --filter @tcg/api catalog:attributes:audit",
    "catalog:attributes:backfill": "pnpm --filter @tcg/api catalog:attributes:backfill",
    "ledger:backfill": "pnpm --filter @tcg/api ledger:backfill",
    "recon:day": "pnpm --filter @tcg/api recon:day",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prisma": "^6.15.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "postcss": "8.5.26"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
