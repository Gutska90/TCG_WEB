  USER_WARNED
  SELLER_SUSPENDED
  SELLER_RESTORED
  REPORT_RESOLVED
  DISPUTE_ASSIGNED
  DISPUTE_RESOLVED
}

model Dispute {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  openedById       String        @map("opened_by_id") @db.Uuid
  buyerId          String        @map("buyer_id") @db.Uuid
  sellerId         String        @map("seller_id") @db.Uuid
  assignedAdminId  String?       @map("assigned_admin_id") @db.Uuid
  reason           DisputeReason
  status           DisputeStatus @default(OPEN)
  resolution       String?
  openedAt         DateTime      @default(now()) @map("opened_at") @db.Timestamptz(6)
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order          Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  openedBy       User               @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  buyer          User               @relation("DisputeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller         User               @relation("DisputeSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  assignedAdmin  User?              @relation("DisputeAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages       DisputeMessage[]
  evidence       DisputeEvidence[]

  @@index([orderId])
  @@index([status, openedAt])
  @@index([assignedAdminId])
  @@map("disputes")
}

model DisputeMessage {
  id                   String   @id @default(uuid()) @db.Uuid
  disputeId            String   @map("dispute_id") @db.Uuid
  authorId             String   @map("author_id") @db.Uuid
  body                 String
  isInternalAdminNote  Boolean  @default(false) @map("is_internal_admin_note")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

model DisputeEvidence {
  id            String               @id @default(uuid()) @db.Uuid
  disputeId     String               @map("dispute_id") @db.Uuid
  uploadedById  String               @map("uploaded_by_id") @db.Uuid
  fileId        String               @map("file_id") @db.Uuid
  evidenceType  DisputeEvidenceType  @map("evidence_type")
  description   String               @default("")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  dispute    Dispute @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  uploadedBy User    @relation("DisputeEvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  file       File    @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([disputeId])
  @@map("dispute_evidence")
}

model Report {
  id               String           @id @default(uuid()) @db.Uuid
  reporterId       String           @map("reporter_id") @db.Uuid
  targetType       ReportTargetType @map("target_type")
