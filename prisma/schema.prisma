model ReconciliationRun {
  id               String                   @id @default(uuid()) @db.Uuid
  provider         String
  startedAt        DateTime                 @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?                @map("finished_at") @db.Timestamptz(6)
  status           ReconciliationRunStatus  @default(RUNNING)
  checkedPayments  Int                      @default(0) @map("checked_payments")
  checkedRefunds   Int                      @default(0) @map("checked_refunds")
  issuesFound      Int                      @default(0) @map("issues_found")
  criticalIssues   Int                      @default(0) @map("critical_issues")
  createdById      String?                  @map("created_by_id") @db.Uuid
  metadata         Json                     @default("{}")

  createdBy User?                 @relation("ReconRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  issues    ReconciliationIssue[]

  @@index([provider, startedAt])
  @@map("reconciliation_runs")
}

model ReconciliationIssue {
  id                 String                     @id @default(uuid()) @db.Uuid
  runId              String                     @map("run_id") @db.Uuid
  issueType          ReconciliationIssueType    @map("issue_type")
  severity           ReconciliationSeverity
  entityType         String                     @map("entity_type")
  entityId           String?                    @map("entity_id") @db.Uuid
  providerPaymentId  String?                    @map("provider_payment_id")
  providerRefundId   String?                    @map("provider_refund_id")
  expectedStatus     String?                    @map("expected_status")
  actualStatus       String?                    @map("actual_status")
  expectedAmountClp  Int?                       @map("expected_amount_clp")
  actualAmountClp    Int?                       @map("actual_amount_clp")
  fingerprint        String
  details            Json                       @default("{}")
  status             ReconciliationIssueStatus  @default(OPEN)
  resolvedAt         DateTime?                  @map("resolved_at") @db.Timestamptz(6)
  resolvedById       String?                    @map("resolved_by_id") @db.Uuid
  resolutionNote     String?                    @map("resolution_note")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  run        ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  resolvedBy User?             @relation("ReconIssueResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([status, severity, createdAt])
  @@index([issueType, createdAt])
  @@index([fingerprint])
  @@map("reconciliation_issues")
}

enum DisputeReason {
  ITEM_NOT_RECEIVED
  WRONG_ITEM
  WRONG_CONDITION
  DAMAGED
  COUNTERFEIT_SUSPECTED
  SELLER_UNRESPONSIVE
  OTHER
}

enum DisputeStatus {
  OPEN
  WAITING_BUYER
  WAITING_SELLER
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  CANCELLED
}

enum DisputeEvidenceType {
  PHOTO
  VIDEO
  DOCUMENT
  OTHER
}

enum ReportTargetType {
  USER
  LISTING
  IMAGE
}

enum ReportReason {
  COUNTERFEIT
  STOLEN_IMAGE
  SPAM
  MISLEADING_DESCRIPTION
  SCAM_SUSPECTED
  ABUSIVE_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
