generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SELLER
  STORE
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum CardLanguage {
  EN
  ES
  JA
  KO
  ZH
  PT
  FR
  DE
  IT
}

enum CardFinish {
  NORMAL
  HOLO
  REVERSE_HOLO
  FOIL
  ETCHED
  FIRST_EDITION
  UNLIMITED
  GRADED
  OTHER
}

enum CardCondition {
  NM
  LP
  MP
  HP
  DMG
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD
  CANCELLED
}

enum ProductType {
  SINGLE
  SEALED
  ACCESSORY
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  READY_FOR_MEETUP
  DELIVERED
  CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
}

enum CheckoutStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  HELD
  RELEASED
  REFUNDED
}

enum ShippingMethod {
  CHILEXPRESS
  BLUE_EXPRESS
  MEETUP
  COORDINATED
  STORE_PICKUP
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum PayoutMethod {
  MANUAL
}

enum LedgerEntryType {
  PAYMENT_CAPTURED
  SELLER_PAYABLE
  PLATFORM_FEE
  REFUND
  PAYOUT_RESERVED
  PAYOUT_PAID
  PAYOUT_REVERSED
  ADJUSTMENT
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReconciliationIssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

enum ReconciliationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ReconciliationIssueType {
  PAYMENT_MISSING_LOCAL
  PAYMENT_MISSING_PROVIDER
  PAYMENT_STATUS_MISMATCH
  PAYMENT_AMOUNT_MISMATCH
  REFUND_MISSING_LOCAL
  REFUND_MISSING_PROVIDER
  REFUND_STATUS_MISMATCH
  REFUND_AMOUNT_MISMATCH
  UNKNOWN_PROVIDER_PAYMENT
  DUPLICATE_PROVIDER_PAYMENT
  LEDGER_MISSING_PAYMENT_CAPTURED
  LEDGER_MISSING_SELLER_PAYABLE
  LEDGER_MISSING_REFUND
  PAYOUT_LEDGER_MISMATCH
}

/// Bootstrap de Fase 0. Se mantiene como marca de migraciones tempranas.
model SchemaMeta {
  id        String   @id @default(uuid()) @db.Uuid
  version   String
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_meta")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  passwordHash    String?   @map("password_hash")
  displayName     String    @map("display_name")
  slug            String    @unique
  avatarFileId    String?   @unique @map("avatar_file_id") @db.Uuid
  tokenVersion    Int       @default(0) @map("token_version")
  isBanned        Boolean   @default(false) @map("is_banned")
  bannedAt        DateTime? @map("banned_at") @db.Timestamptz(6)
  bannedReason    String?   @map("banned_reason")
  termsVersion    String?   @map("terms_version")
  privacyVersion  String?   @map("privacy_version")
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  marketingOptIn  Boolean   @default(false) @map("marketing_opt_in")
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  avatar               File?                    @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  uploadedFiles        File[]                   @relation("FileUploader")
  roles                UserRole[]
  identities           AuthIdentity[]
  sessions             Session[]
  profile              Profile?
  emailVerifyTokens    EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]
  favorites            Favorite[]
  wishlistItems        WishlistItem[]
  notifications        Notification[]
  notificationPreferences NotificationPreference[]
  collections          Collection[]
  addresses            Address[]
  listings             Listing[]
  cart                 Cart?
  checkouts            Checkout[]
  ordersBought         Order[]  @relation("OrderBuyer")
  ordersSold           Order[]  @relation("OrderSeller")
  payouts              Payout[]
  payoutsApproved      Payout[]                 @relation("PayoutApprover")
  payoutItems          PayoutItem[]
  ledgerEntries        LedgerEntry[]
  reconRunsCreated     ReconciliationRun[]      @relation("ReconRunCreator")
  reconIssuesResolved  ReconciliationIssue[]    @relation("ReconIssueResolver")
  ratingsGiven         SellerRating[] @relation("RatingFrom")
  ratingsReceived      SellerRating[] @relation("RatingTo")
  disputesOpened       Dispute[]            @relation("DisputeOpenedBy")
  disputesAsBuyer      Dispute[]            @relation("DisputeBuyer")
  disputesAsSeller     Dispute[]            @relation("DisputeSeller")
  disputesAssigned     Dispute[]            @relation("DisputeAssignee")
  disputeMessages      DisputeMessage[]
  disputeEvidence      DisputeEvidence[]    @relation("DisputeEvidenceUploader")
  reportsFiled         Report[]             @relation("ReportReporter")
  reportsAssigned      Report[]             @relation("ReportAssignee")
  listingRevisions     ListingRevision[]
  moderationActions    ModerationAction[]
  suspensionsReceived  SellerSuspension[]   @relation("SellerSuspended")
  suspensionsCreated   SellerSuspension[]   @relation("SuspensionCreator")
  suspensionsLifted    SellerSuspension[]   @relation("SuspensionLifter")
  feedback             Feedback[]

  @@map("users")
}

model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        Role
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedById String?  @map("granted_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Profile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  bio                String?
  region             String?
  comuna             String?
  country            String    @default("CL")
  sellerOnboardedAt  DateTime? @map("seller_onboarded_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model File {
  id           String   @id @default(uuid()) @db.Uuid
  bucket       String
  key          String
  mime         String
  size         Int
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  status       String   @default("PENDING")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  uploadedBy User?          @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  avatarFor  User?          @relation("UserAvatar")
  setImages  TcgSet[]       @relation("SetImage")
  listingImages ListingImage[]
  disputeEvidence DisputeEvidence[]

  @@unique([bucket, key])
  @@map("files")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model TcgGame {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  publisher String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sets TcgSet[]

  @@map("tcg_games")
}

model TcgSet {
  id           String    @id @default(uuid()) @db.Uuid
  gameId       String    @map("game_id") @db.Uuid
  code         String
  slug         String
  name         String
  releasedAt   DateTime? @map("released_at") @db.Timestamptz(6)
  printedTotal Int?      @map("printed_total")
  total        Int?
  imageUrl     String?   @map("image_url")
  imageFileId  String?   @map("image_file_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  game      TcgGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  imageFile File?   @relation("SetImage", fields: [imageFileId], references: [id], onDelete: SetNull)
  cards     Card[]

  @@unique([gameId, code])
  @@unique([gameId, slug])
  @@index([gameId])
  @@map("sets")
}

/// Índices GIN `immutable_unaccent_lower` (pg_trgm) están en la migración Fase 3; Prisma no los modela.
model Card {
  id         String   @id @default(uuid()) @db.Uuid
  setId      String   @map("set_id") @db.Uuid
  number     String
  slug       String
  name       String
  rarity     String
  supertype  String
  attributes Json     @default("{}")
  imageUrl   String?  @map("image_url")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  set      TcgSet        @relation(fields: [setId], references: [id], onDelete: Cascade)
  variants CardVariant[]

  @@unique([setId, number, name])
  @@unique([setId, slug])
  @@index([setId])
  @@map("cards")
}

model CardVariant {
  id           String       @id @default(uuid()) @db.Uuid
  cardId       String       @map("card_id") @db.Uuid
  language     CardLanguage
  finish       CardFinish
  finishDetail String       @default("") @map("finish_detail")
  isDefault    Boolean      @default(false) @map("is_default")
  externalIds  Json         @default("{}") @map("external_ids")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  card            Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  favorites       Favorite[]
  wishlistItems   WishlistItem[]
  listings        Listing[]
  prices          CardPrice[]
  orderItems      OrderItem[]
  collectionItems CollectionItem[]

  @@unique([cardId, language, finish, finishDetail])
  @@index([cardId])
  @@map("card_variants")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant CardVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
  @@map("favorites")
}

model WishlistItem {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  variantId             String   @map("variant_id") @db.Uuid
  targetPriceClp        Int      @map("target_price_clp")
  notifyBelow           Boolean  @default(true) @map("notify_below")
  lastNotifiedListingId String?  @map("last_notified_listing_id") @db.Uuid
  lastNotifiedPriceClp  Int?     @map("last_notified_price_clp")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant CardVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
  @@index([variantId])
  @@map("wishlist_items")
}

model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json                 @default("{}")
  channel   NotificationChannel  @default(IN_APP)
  dedupeKey String?              @map("dedupe_key")
  readAt    DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  type   String
  inApp  Boolean @default(true) @map("in_app")
  email  Boolean @default(true)
  push   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preferences")
}

/// Colección personal (Fase 12). MVP: una fila Default por usuario (`userId` unique).
/// No es inventario de Listing: una carta puede estar aquí y también publicada.
model Collection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  name      String   @default("Default")
  isDefault Boolean  @default(true) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]
  valueSnapshots CollectionValueSnapshot[]

  @@map("collections")
}

/// Lote de compra. No hay unique (collection, variant, condition): el mismo printing
/// con distinto purchasePriceClp debe coexistir. Duplicados se calculan en lectura.
model CollectionItem {
  id               String        @id @default(uuid()) @db.Uuid
  collectionId     String        @map("collection_id") @db.Uuid
  variantId        String        @map("variant_id") @db.Uuid
  condition        CardCondition
  quantity         Int
  purchasePriceClp Int?          @map("purchase_price_clp")
  purchasedAt      DateTime?     @map("purchased_at") @db.Date
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  variant    CardVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  listings   Listing[]

  @@index([collectionId, createdAt])
  @@index([collectionId, variantId, condition])
  @@index([variantId])
  @@map("collection_items")
}

model CollectionValueSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  capturedOn   DateTime @map("captured_on") @db.Date
  valueClp     Int      @map("value_clp")
  breakdown    Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, capturedOn])
  @@index([capturedOn])
  @@map("collection_value_snapshots")
}

model Address {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  label              String   @default("Principal")
  recipientName      String   @map("recipient_name")
  phone              String
  line1              String
  line2              String?
  comuna             String
  region             String
  postalCode         String?  @map("postal_code")
  isDefaultShipping  Boolean  @default(false) @map("is_default_shipping")
  isDefaultBilling   Boolean  @default(false) @map("is_default_billing")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[]

  @@index([userId])
  @@map("addresses")
}

model Listing {
  id                String        @id @default(uuid()) @db.Uuid
  sellerId          String        @map("seller_id") @db.Uuid
  storeId           String?       @map("store_id") @db.Uuid
  variantId         String?       @map("variant_id") @db.Uuid
  productType       ProductType   @default(SINGLE) @map("product_type")
  title             String
  condition         CardCondition?
  quantity          Int
  quantityReserved  Int           @default(0) @map("quantity_reserved")
  priceClp          Int           @map("price_clp")
  status            ListingStatus @default(ACTIVE)
  description       String        @default("")
  allowsMeetup      Boolean       @default(true) @map("allows_meetup")
  allowsShipping    Boolean       @default(true) @map("allows_shipping")
  graded            Boolean       @default(false)
  grader            String?
  grade             String?
  sourceCollectionItemId String?       @map("source_collection_item_id") @db.Uuid
  publishedAt            DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller               User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  variant              CardVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sourceCollectionItem CollectionItem? @relation(fields: [sourceCollectionItemId], references: [id], onDelete: SetNull)
  images               ListingImage[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  revisions            ListingRevision[]

  @@index([sellerId])
  @@index([variantId, status])
  @@index([status, priceClp])
  @@index([sourceCollectionItemId])
  @@map("listings")
}

model ListingImage {
  id        String @id @default(uuid()) @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([listingId, fileId])
  @@index([listingId])
  @@map("listing_images")
}

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid
  guestToken String?  @unique @map("guest_token")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@unique([cartId, listingId])
  @@index([listingId])
  @@map("cart_items")
}

model CardPrice {
  id         String   @id @default(uuid()) @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  source     String
  priceClp   Int      @map("price_clp")
  capturedOn DateTime @map("captured_on") @db.Date
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  variant CardVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, source, capturedOn])
  @@index([variantId, capturedAt])
  @@map("card_prices")
}

model Checkout {
  id                       String         @id @default(uuid()) @db.Uuid
  buyerId                  String         @map("buyer_id") @db.Uuid
  status                   CheckoutStatus @default(PENDING_PAYMENT)
  totalClp                 Int            @map("total_clp")
  mercadoPagoPreferenceId  String?        @unique @map("mercado_pago_preference_id")
  idempotencyKey           String?        @map("idempotency_key")
  expiresAt                DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyer  User    @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  orders Order[]

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId, status])
  @@map("checkouts")
}

model Order {
  id                 String         @id @default(uuid()) @db.Uuid
  orderNumber        String         @unique @map("order_number")
  checkoutId         String         @map("checkout_id") @db.Uuid
  buyerId            String         @map("buyer_id") @db.Uuid
  sellerId           String         @map("seller_id") @db.Uuid
  status             OrderStatus    @default(PENDING_PAYMENT)
  subtotalClp        Int            @map("subtotal_clp")
  shippingClp        Int            @map("shipping_clp")
  commissionClp      Int            @map("commission_clp")
  totalClp           Int            @map("total_clp")
  shippingMethod     ShippingMethod @map("shipping_method")
  shippingAddressId  String?        @map("shipping_address_id") @db.Uuid
  notes              String         @default("")
  paidAt             DateTime?      @map("paid_at") @db.Timestamptz(6)
  shippedAt          DateTime?      @map("shipped_at") @db.Timestamptz(6)
  deliveredAt        DateTime?      @map("delivered_at") @db.Timestamptz(6)
  confirmedAt        DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  completedAt        DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  checkout        Checkout  @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  buyer           User      @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller          User      @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  shippingAddress Address?  @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payment         Payment?
  shipment        Shipment?
  rating          SellerRating?
  payoutItems     PayoutItem[]
  ledgerEntries   LedgerEntry[]
  disputes        Dispute[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([checkoutId])
  @@map("orders")
}

model OrderItem {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  listingId      String         @map("listing_id") @db.Uuid
  variantId      String         @map("variant_id") @db.Uuid
  titleSnapshot  String         @map("title_snapshot")
  condition      CardCondition
  quantity       Int
  unitPriceClp   Int            @map("unit_price_clp")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing     @relation(fields: [listingId], references: [id], onDelete: Restrict)
  variant CardVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([listingId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  orderId            String        @unique @map("order_id") @db.Uuid
  provider           String        @default("MERCADOPAGO")
  providerPaymentId  String?       @map("provider_payment_id")
  status             PaymentStatus @default(PENDING)
  amountClp          Int           @map("amount_clp")
  rawPayload         Json          @default("{}") @map("raw_payload")
  heldAt             DateTime?     @map("held_at") @db.Timestamptz(6)
  releasedAt         DateTime?     @map("released_at") @db.Timestamptz(6)
  refundedAt         DateTime?     @map("refunded_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds       Refund[]
  ledgerEntries LedgerEntry[]

  @@index([providerPaymentId])
  @@map("payments")
}

model WebhookEvent {
  id               String    @id @default(uuid()) @db.Uuid
  provider         String
  providerEventId  String    @map("provider_event_id")
  payload          Json
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amountClp        Int          @map("amount_clp")
  reason           String
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @unique @map("provider_refund_id")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@index([paymentId])
  @@map("refunds")
}

model Payout {
  id           String       @id @default(uuid()) @db.Uuid
  sellerId     String       @map("seller_id") @db.Uuid
  amountClp    Int          @map("amount_clp")
  status       PayoutStatus @default(PENDING)
  method       PayoutMethod @default(MANUAL)
  providerRef  String?      @map("provider_ref")
  periodStart  DateTime     @map("period_start") @db.Timestamptz(6)
  periodEnd    DateTime     @map("period_end") @db.Timestamptz(6)
  approvedById String?      @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?    @map("approved_at") @db.Timestamptz(6)
  paidAt       DateTime?    @map("paid_at") @db.Timestamptz(6)
  lastError    String?      @map("last_error")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller        User          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  approvedBy    User?         @relation("PayoutApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items         PayoutItem[]
  ledgerEntries LedgerEntry[]

  @@index([sellerId, status])
  @@map("payouts")
}

/// Snapshot de órdenes incluidas en un lote de payout. `locksOrder` + índice
/// único parcial impide que la misma obligación viva en dos payouts activos.
model PayoutItem {
  id            String   @id @default(uuid()) @db.Uuid
  payoutId      String   @map("payout_id") @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  sellerId      String   @map("seller_id") @db.Uuid
  grossClp      Int      @map("gross_clp")
  commissionClp Int      @map("commission_clp")
  netClp        Int      @map("net_clp")
  locksOrder    Boolean  @default(true) @map("locks_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller User   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([payoutId])
  @@index([sellerId])
  @@map("payout_items")
}

/// Libro operacional append-only. Nunca UPDATE/DELETE; correcciones = INSERT.
model LedgerEntry {
  id              String          @id @default(uuid()) @db.Uuid
  sellerId        String?         @map("seller_id") @db.Uuid
  entryType       LedgerEntryType @map("entry_type")
  amountClp       Int             @map("amount_clp")
  orderId         String?         @map("order_id") @db.Uuid
  paymentId       String?         @map("payment_id") @db.Uuid
  refundId        String?         @map("refund_id") @db.Uuid
  payoutId        String?         @map("payout_id") @db.Uuid
  idempotencyKey  String          @unique @map("idempotency_key")
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  seller  User?    @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund  Refund?  @relation(fields: [refundId], references: [id], onDelete: Restrict)
  payout  Payout?  @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt])
  @@index([entryType, createdAt])
  @@index([orderId])
  @@index([paymentId])
  @@index([refundId])
  @@index([payoutId])
  @@map("ledger_entries")
}

model Shipment {
