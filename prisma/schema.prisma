  assignedAdmin User? @relation("ReportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
  @@map("reports")
}

model ListingRevision {
