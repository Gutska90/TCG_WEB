NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://tcg:tcg@localhost:5432/tcg_platform
REDIS_URL=redis://localhost:6379

# Obligatorio. Mínimo 32 caracteres. Prohibido change-me / dev-only-change-me.
JWT_ACCESS_SECRET=
JWT_ISSUER=tcg-platform
APP_WEB_URL=http://localhost:3000
APP_ADMIN_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_SECRET=
# Web GIS (mismo valor que GOOGLE_CLIENT_ID_WEB). Next lo lee como NEXT_PUBLIC_*.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Referencia de secreto (no pegar la .p8 en el repo): p.ej. AWS secret name / file path fuera de git.
APPLE_PRIVATE_KEY_REF=
ENABLE_GOOGLE_AUTH=false
ENABLE_APPLE_AUTH=false
# Solo tests/CI. Prohibido en production y con pagos reales.
AUTH_STUB_OAUTH=false

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_KEY=
API_PUBLIC_URL=http://localhost:4000

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

RESEND_API_KEY=
EMAIL_FROM=TCG Platform <noreply@localhost>

ERROR_TRACKING_ENABLED=false
ENABLE_REAL_PAYMENTS=false
# Cuentas sintéticas de QA: pnpm beta:seed (ver docs/release/WEB-BETA-QA.md)
# Nunca true en el repo. Solo tras revisión legal (ADR 0008 + LEGAL-BETA).
REAL_PAYMENTS_LEGAL_APPROVED=false
ENABLE_PAYOUTS=true
ENABLE_COLLECTIONS=true
ENABLE_PRICES=true
ENABLE_WISHLIST=true
ENABLE_SCANNER=false
ENABLE_STORES=false
ENABLE_AUCTIONS=false
# Mobile (apps/mobile): EXPO_PUBLIC_API_BASE_URL, EXPO_PUBLIC_APP_ENV, EXPO_PUBLIC_ENABLE_REAL_PAYMENTS=false
# Ver apps/mobile/.env.example y docs/10-MOBILE.md
DISABLE_CHECKOUT=false
DISABLE_NEW_LISTINGS=false
DISABLE_PAYOUTS=false
DISABLE_REFUNDS_AUTOMATION=false
JOBS_ENABLED=true
ENABLE_REFUND_RETRY_JOB=false
