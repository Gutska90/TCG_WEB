# Staging — copy to secret manager, never commit filled values.
# Usage: APP_ENV=staging NODE_ENV=production (or NODE_ENV=staging)

NODE_ENV=staging
APP_ENV=staging
PORT=4000
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_ISSUER=tcg-platform
APP_WEB_URL=https://staging.example.test
APP_ADMIN_URL=https://admin.staging.example.test
API_PUBLIC_URL=https://api.staging.example.test
CORS_ORIGINS=https://staging.example.test,https://admin.staging.example.test
ADMIN_IP_ALLOWLIST=

ENABLE_GOOGLE_AUTH=false
ENABLE_APPLE_AUTH=false
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
APPLE_CLIENT_ID=
AUTH_STUB_OAUTH=false

ENABLE_REAL_PAYMENTS=false
REAL_PAYMENTS_LEGAL_APPROVED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_KEY=

# Cloudflare R2 (preferred) — or Minio/S3 below
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# S3/Minio (local or alternative). If S3_ENDPOINT is set, it wins over R2.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true

RESEND_API_KEY=
EMAIL_FROM=TCG Market Chile <noreply@staging.example.test>
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

ENABLE_PAYOUTS=true
ENABLE_COLLECTIONS=true
ENABLE_PRICES=true
ENABLE_WISHLIST=true
ENABLE_SELLER_PLANS=true
# Staging público: oculta Ember Pup / Andes Demo / Test Mon. Local e2e sigue en .env.example=true.
SHOW_SYNTHETIC_CATALOG=false
# Opcional. Solo API (`pnpm catalog:import-pokemon`). Nunca Next/mobile.
POKEMON_TCG_API_KEY=
ENABLE_SCANNER=false
ENABLE_STORES=false
ENABLE_AUCTIONS=false
DISABLE_CHECKOUT=false
DISABLE_NEW_LISTINGS=false
DISABLE_PAYOUTS=false
DISABLE_REFUNDS_AUTOMATION=false
JOBS_ENABLED=true
ENABLE_REFUND_RETRY_JOB=false
ERROR_TRACKING_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
REDIS_URL=

# --- Next.js web + admin (también en el host Next; no las usa Nest) ---
API_ORIGIN=https://api.staging.example.test
# LEGAL_CONTACT_EMAIL y LEGAL_PRIVACY_EMAIL: mismos valores que arriba en web/admin.
