# API local para simulador iOS. En emulador Android usa 10.0.2.2. En dispositivo físico, la IP LAN de tu máquina.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ENABLE_REAL_PAYMENTS=false
EXPO_PUBLIC_ANALYTICS=false
# OAuth (11.5). Vacío = botones nativos ocultos; la API también exige ENABLE_GOOGLE_AUTH / ENABLE_APPLE_AUTH.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
# Staging/production (B6/B7): HTTPS público, nunca localhost. Lo inyecta EAS secret / CI.
# EXPO_PUBLIC_API_BASE_URL=https://api.staging.example
# Associated Domains / App Links (opcional, host sin esquema):
# EXPO_PUBLIC_ASSOCIATED_DOMAIN=app.staging.example
# Solo en EAS / CI, no commitear el valor real.
# EAS_PROJECT_ID=
