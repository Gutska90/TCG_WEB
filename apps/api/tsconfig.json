{
  "extends": "@tcg/tsconfig/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@tcg/config": ["../../packages/config/src/index.ts"],
      "@tcg/types": ["../../packages/types/src/index.ts"],
      "@tcg/validation": ["../../packages/validation/src/index.ts"]
    },
    "declaration": false,
    "declarationMap": false,
    "noEmit": false,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
